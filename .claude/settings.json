{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous-bash.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-guard.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
