{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "caiqueazevedu@gmail.com",
    },
  ],
  "vars": {
    "CONTACT_TO": "caiqueazevedu@gmail.com",
    "CONTACT_FROM": "site@caiqueazevedo.com.br",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "",
  },

  "routes": [{ "pattern": "www.caiqueazevedo.com.br", "custom_domain": true }],
  "observability": { "enabled": true },
}
